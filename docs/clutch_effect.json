{
  "meta": {
    "estimand": "Clutch residual: observed FG% minus expected FG% from a shot-quality model fitted only on regular-play shots, in percentage points. Positive = observed > expected; negative = observed < expected. This is a descriptive quantity; it bundles defensive intensity, fatigue, shot selection within type, shooter composition, and any other difference between clutch and regular play.",
    "baseline_fitted_on": "REGULAR shots only (196,198 shots)",
    "clutch_outcomes_in_baseline": false,
    "n_bootstrap": 2000,
    "bootstrap_method": "game-level cluster bootstrap (resample GAME_IDs), 95% percentile CI",
    "rng_seed": 42,
    "precision_note": "Binomial standard error about 0.6 pp for the overall clutch residual (7,104 shots), about 0.8 pp for 2PT (4,246 shots), about 0.9 pp for 3PT (2,858 shots). The 95% interval half-width is about 1 pp overall.",
    "model_B_uncertainty_note": "Player offsets (b_player) are treated as fixed in the bootstrap. This slightly understates Model B uncertainty."
  },
